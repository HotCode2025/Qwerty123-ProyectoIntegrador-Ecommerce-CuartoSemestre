# Copiá este archivo como .env (en esta misma carpeta) y completá tus datos locales.
# El archivo .env no se sube a Git.
DB_URL=jdbc:mysql://localhost:3306/golden_point?createDatabaseIfNotExist=true
DB_USER=root
DB_PASSWORD=

# Clave para firmar los tokens JWT (mínimo 32 caracteres)
# Se puede crear con este comando:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Primer administrador de la tienda (se crea solo al arrancar si no existe ninguno)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Mercado Pago: Access Token de la cuenta de prueba Vendedor
MP_ACCESS_TOKEN=
# URL del frontend a la que vuelve el cliente después de pagar
FRONTEND_URL=http://localhost:5173
# Brevo: clave de API (SMTP y API → Claves API) y remitente verificado.
# Si se dejan vacías, los mails se muestran en el log en lugar de enviarse.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Cloudinary (fotos de productos): cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
# Solo en el deploy: clave secreta de webhooks y URL pública del backend para recibir avisos
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=